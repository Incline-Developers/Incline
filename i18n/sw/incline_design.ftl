    { $count ->
        [one] mfuatano { $count }
       *[other] mifuatano { $count }
    }
tri-count-points =
    { $count ->
        [one] kidokezo { $count }
       *[other] vidokezo { $count }
    }
tri-count-texts =
    { $count ->
        [one] kitu { $count } cha maandishi
       *[other] vitu { $count } vya maandishi
    }
tri-count-objects =
    { $count ->
        [one] kitu { $count }
       *[other] vitu { $count }
    }

